# 复制为 .env 后使用：cp .env.example .env
# 注意：SESSION_SECRET 与 ENCRYPTION_KEY 必须替换为随机值，
# 生产模式下使用本文件的示例值会导致服务直接启动失败。
#   生成命令：openssl rand -base64 32

NODE_ENV=production
# 平台对外地址。必须改成真实域名——
# canonical 与 og:image 由此生成，指向错误域名会把 SEO 权重转给别人。
APP_URL=https://rankloop.miaokit.cloud

# 容器在宿主上的绑定地址与端口，只给反代用，不对公网开放。
# 反代若也跑在容器里（如 1Panel 的 OpenResty），必须绑到 docker 网桥网关
# 172.17.0.1——绑 127.0.0.1 时反代容器连不上，站点会 502。
# 端口若被机器上其他服务占用，换一个空闲的，并同步改反代的 proxy_pass。
HOST_BIND=127.0.0.1
HOST_PORT=8080

POSTGRES_DB=rankloop
POSTGRES_USER=rankloop
POSTGRES_PASSWORD=change-me

SESSION_SECRET=change-to-at-least-32-random-bytes
ENCRYPTION_KEY=change-to-32-byte-key


# 平台管理员账号。客户不自助注册——管理员登录后台创建租户并分配 API Key。
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-at-least-10-chars

# 平台根域名，租户站点为 <slug>.<该域名>
PLATFORM_DOMAIN=rankloop.miaokit.cloud

LOG_LEVEL=info

# Search Console 服务账号（整个 JSON 密钥文件的内容，单行）。
# 配置后才会自动提交 sitemap 并每日回读点击/曝光/排名；
# 缺了它，闭环止步于「发布」，看不到发布后的效果。
# 记得把服务账号邮箱在 Search Console 里加为资源的用户。
GSC_SERVICE_ACCOUNT=

# Chrome UX Report API Key，用于读取 Core Web Vitals（LCP/INP/CLS）。
# 这些指标平台自己测不出来——它们衡量真实浏览器为真实用户渲染页面的过程，
# 而我们只收到一份 HTML 文本。CrUX 汇总真实 Chrome 用户上报的数据，
# 也正是 Google 排名时参考的那一份。
#
# 申请：Google Cloud Console 启用「Chrome UX Report API」后创建 API 密钥。
# 免费，与 GSC 服务账号相互独立。
#
# 注意：CrUX 只对样本量足够的页面有数据，低流量站点会持续返回「无数据」，
# 这是正常的，面板会如实说明而不是显示 0。
CRUX_API_KEY=

# 配额（规格 §8.3）
DEFAULT_MAX_SITES=5
DEFAULT_MAX_CONTENTS=1000
DEFAULT_DAILY_INDEXNOW=200
DEFAULT_MAX_WEBHOOKS=10
