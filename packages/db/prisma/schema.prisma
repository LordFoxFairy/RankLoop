// RankLoop SEO — 数据模型
// 范围见 docs/ADR-001-内容托管闭环.md：MVP 只做托管闭环，crawl_* 相关表属二期。

generator client {
  provider = "prisma-client-js"
  // 容器运行时需要对应平台的查询引擎；缺少 linux 目标会导致镜像内启动失败。
  // 同时覆盖 arm64 与 amd64，以支持多架构镜像（规格 §10.2）。
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 身份与租户 ----------

model User {
  id            String            @id @default(uuid()) @db.Uuid
  // 邮箱唯一性不区分大小写：写入前统一转小写（规格 §6）
  email         String            @unique
  passwordHash  String            @map("password_hash")
  displayName   String?           @map("display_name")
  isPlatformAdmin Boolean         @default(false) @map("is_platform_admin")
  disabledAt    DateTime?         @map("disabled_at") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  memberships   WorkspaceMember[]
  auditLogs     AuditLog[]
  sessions      Session[]

  @@map("users")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String            @unique
  // 是否允许绑定自有域名。默认开启——自有域名是主推形态：
  // 内容权重归客户自己的域名，SEO 效果远好于平台三级子域名。
  // 平台管理员可对个别租户关闭。
  customDomainEnabled Boolean @default(true) @map("custom_domain_enabled")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  members   WorkspaceMember[]
  sites     Site[]
  apiKeys   ApiKey[]
  webhooks  Webhook[]
  auditLogs AuditLog[]
  quota     WorkspaceQuota?

  @@map("workspaces")
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // 只存哈希：数据库泄露时无法直接冒用会话
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz
  userAgent String?  @map("user_agent")
  ip        String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// 邀请码。当前**未接线**：平台不开放自助注册，账号由管理员创建，
/// 租户凭签发的 API Key 调用接口，无需登录，因此没有邀请流程。
/// 保留表结构是为将来支持多人协作工作区时不必再做迁移。
model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole
  codeHash    String        @map("code_hash")
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?     @map("accepted_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId])
  @@map("invitations")
}

// ---------- 站点 ----------

model Site {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  // 规范化 origin（scheme://host[:port]），同工作区内唯一（规格 §6）
  origin      String
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // 子域名标识：访客通过 <slug>.<平台域名> 访问。
  // 这是兜底形态——三级子域名会把权重积累到平台域名下，
  // 且 Google 视子域名为独立站点，租户需从零建立信任度。
  // 因此仅在客户尚未绑定自有域名时使用。
  // 全局唯一——两个站点用同一 slug 会导致访客看到错误租户的内容。
  slug        String    @unique
  // 自定义域名（主推形态）。权重归客户自己的域名，SEO 效果最优。
  // 路由层对 slug 子域名与自定义域名走同一套 Host 查找逻辑。
  domain      String?   @unique
  domainVerifiedAt DateTime? @map("domain_verified_at") @db.Timestamptz
  // 站点级展示配置：站点名、导航、主题色等，各租户独立
  settings    Json      @default("{}")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents    Content[]
  indexNowKey IndexNowKey?
  indexNowSubmissions IndexNowSubmission[]
  searchAnalytics SearchAnalytics[]
  gscSyncJobs GscSyncJob[]

  @@unique([workspaceId, origin])
  @@index([domain])
  @@map("sites")
}

// ---------- 托管内容（ADR-001 核心） ----------

enum ContentFormat {
  html
  markdown
}

enum ContentStatus {
  draft       // 已提交，未发布
  published   // 已通过门槛并发布
  archived
}

model Content {
  id          String        @id @default(uuid()) @db.Uuid
  siteId      String        @map("site_id") @db.Uuid
  // 站内相对路径，规范化后同站点唯一
  path        String
  format      ContentFormat
  status      ContentStatus @default(draft)
  // 当前生效版本
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  // 线上实际生效的版本。与 currentVersionId 不同时说明有修订待发布——
  // 少了它就无法判断「修订后能否再次发布」，修复版本会永远上不了线。
  publishedVersionId String? @map("published_version_id") @db.Uuid
  publishedAt DateTime?     @map("published_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  versions    ContentVersion[] @relation("ContentVersions")
  currentVersion ContentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@unique([siteId, path])
  @@index([siteId, status])
  @@map("contents")
}

model ContentVersion {
  id          String    @id @default(uuid()) @db.Uuid
  contentId   String    @map("content_id") @db.Uuid
  version     Int
  // 正文原文。markdown 存 MD 源码，html 存 HTML 源码。
  body        String
  // Markdown frontmatter 解析结果 / HTML 提取的元数据
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  content     Content   @relation("ContentVersions", fields: [contentId], references: [id], onDelete: Cascade)
  currentOf   Content?  @relation("CurrentVersion")
  checks      ContentCheck[]

  @@unique([contentId, version])
  @@map("content_versions")
}

model ContentCheck {
  id          String   @id @default(uuid()) @db.Uuid
  versionId   String   @map("version_id") @db.Uuid
  // 健康分，由可配置权重计算（规格 §3.4：不得用不可解释的总分替代具体问题）
  score       Int
  criticalCount Int    @map("critical_count")
  warningCount  Int    @map("warning_count")
  noticeCount   Int    @map("notice_count")
  // 完整问题列表：规则编码、级别、证据、修复建议
  issues      Json
  // 因输入格式限制而跳过的规则及原因（ADR-001 §3：不得产生假阳性）
  skippedRules Json    @default("[]") @map("skipped_rules")
  rulesVersion String  @map("rules_version")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  version     ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("content_checks")
}

// ---------- IndexNow ----------

model IndexNowKey {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @unique @map("site_id") @db.Uuid
  key       String
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("indexnow_keys")
}

enum SubmissionStatus {
  queued
  succeeded
  failed
}

model IndexNowSubmission {
  id          String           @id @default(uuid()) @db.Uuid
  siteId      String           @map("site_id") @db.Uuid
  urls        Json
  event       String
  status      SubmissionStatus @default(queued)
  responseCode Int?            @map("response_code")
  responseSummary String?      @map("response_summary")
  // 幂等键，防止重复提交（规格 §7.4）
  idempotencyKey String?       @map("idempotency_key")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, idempotencyKey])
  @@index([siteId, createdAt])
  @@map("indexnow_submissions")
}

// ---------- Search Console 数据 ----------

/**
 * 每日搜索表现，按 站点+日期+维度 存储。
 *
 * Search Console 数据有 2-3 天延迟，且历史数据可能被回溯修正，
 * 因此用 upsert 而非 insert——同一天重复同步应覆盖而非累加。
 */
model SearchAnalytics {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  date        DateTime @db.Date
  // 维度值：query 为关键词，page 为落地页。
  // 用空串而非 NULL 表示「该维度未使用」——Postgres 中 NULL != NULL，
  // 含 NULL 的唯一索引无法去重，重复同步会产生重复行。
  query       String   @default("")
  page        String   @default("")
  country     String   @default("")
  device      String   @default("")
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // 同一维度组合每天只应有一条；重复同步时按此键覆盖
  @@unique([siteId, date, query, page, country, device], name: "unique_metric")
  @@index([siteId, date])
  @@index([siteId, query])
  @@map("search_analytics")
}

/** 同步任务记录：游标、时间范围、错误与配额状态 */
model GscSyncJob {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  status      String   @default("running")
  rowsSynced  Int      @default(0) @map("rows_synced")
  error       String?
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, startedAt])
  @@map("gsc_sync_jobs")
}

// ---------- API Key / Webhook / 审计 ----------

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  // 只存哈希与前缀，明文仅创建时展示一次（规格 §6、§8.2）
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  scopes      String[]
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

model Webhook {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  url         String
  // HMAC-SHA256 签名密钥（规格 §7.5）
  secret      String
  events      String[]
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  webhookId   String    @map("webhook_id") @db.Uuid
  eventId     String    @map("event_id")
  event       String
  payload     Json
  statusCode  Int?      @map("status_code")
  attempt     Int       @default(0)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  action      String
  resource    String
  resourceId  String?   @map("resource_id")
  metadata    Json      @default("{}")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model WorkspaceQuota {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @unique @map("workspace_id") @db.Uuid
  maxSites      Int       @map("max_sites")
  maxContents   Int       @map("max_contents")
  dailyIndexNow Int       @map("daily_indexnow")
  maxWebhooks   Int       @map("max_webhooks")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_quotas")
}
